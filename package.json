{
  "name": "clip-eva-robot",
  "version": "0.1.0",
  "description": "Interactive Three.js OLED Robot Visualizer & Procedural Emotion System for Angular",
  "keywords": [
    "angular",
    "threejs",
    "robot",
    "emotions",
    "3d",
    "webgl",
    "oled-face"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@angular/common": ">=18.0.0",
    "@angular/core": ">=18.0.0",
    "@angular/forms": ">=18.0.0",
    "three": ">=0.160.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "module": "fesm2022/clip-eva-robot.mjs",
  "typings": "types/clip-eva-robot.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/clip-eva-robot.d.ts",
      "default": "./fesm2022/clip-eva-robot.mjs"
    }
  },
  "type": "module"
}